generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  VC
  SECRETARY
  STAFF
}

enum UserStatus {
  ACTIVE
  INVITED
  SUSPENDED
}

enum AlumniStatus {
  PENDING
  APPROVED
  REVIEW
}

/// Dashboard / control-center accounts
model User {
  id           String     @id @default(cuid())
  name         String
  email        String     @unique
  passwordHash String?
  role         UserRole   @default(STAFF)
  status       UserStatus @default(INVITED)
  lastActiveAt DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([role])
  @@index([status])
  @@map("users")
}

/// Alumni association members (fields mirror Update Your Alumni Records)
model Alumni {
  id                 String       @id @default(cuid())
  /// Upload avatar
  avatarUrl          String?
  /// Academic records
  registrationNumber String?      @unique
  faculty            String?
  department         String?
  graduationYear     Int?         @map("yearOfEntry")
  /// Personal records
  surname            String?
  firstName          String?
  otherNames         String?      @map("middleName")
  dateOfBirth        DateTime?    @db.Date
  email              String?      @unique
  phone              String?
  passwordHash       String?
  countryOfOrigin    String?      @map("nationality")
  stateOfOrigin      String?
  homeTown           String?      @map("localGovOfOrigin")
  countryOfResidence String?
  stateOfResidence   String?
  status             AlumniStatus @default(PENDING)
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  executives Executive[]

  @@index([faculty])
  @@index([department])
  @@index([graduationYear])
  @@index([status])
  @@map("alumni")
}

/// National / association executives shown on the public site
model Executive {
  id        String   @id @default(cuid())
  name      String
  role      String
  faculty   String?
  email     String?
  phone     String?
  tenure    String?
  imageUrl  String?
  published Boolean  @default(false)
  sortOrder Int      @default(0)
  alumniId  String?
  alumni    Alumni?  @relation(fields: [alumniId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([published])
  @@index([sortOrder])
  @@index([alumniId])
  @@map("executives")
}

/// Academic faculties (e.g. Engineering, Law)
model Faculty {
  id          String       @id @default(cuid())
  name        String       @unique
  published   Boolean      @default(true)
  sortOrder   Int          @default(0)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  departments Department[]

  @@index([published])
  @@index([sortOrder])
  @@map("faculties")
}

/// Departments belonging to a faculty
model Department {
  id        String   @id @default(cuid())
  name      String
  published Boolean  @default(true)
  sortOrder Int      @default(0)
  facultyId String
  faculty   Faculty  @relation(fields: [facultyId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([facultyId, name])
  @@index([facultyId])
  @@index([published])
  @@index([sortOrder])
  @@map("departments")
}
