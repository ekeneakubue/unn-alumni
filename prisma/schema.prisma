generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  VC
  SECRETARY
  STAFF
}

enum UserStatus {
  ACTIVE
  INVITED
  SUSPENDED
}

enum AlumniStatus {
  PENDING
  APPROVED
  REVIEW
}

/// Dashboard / control-center accounts
model User {
  id           String     @id @default(cuid())
  name         String
  email        String     @unique
  passwordHash String?
  role         UserRole   @default(STAFF)
  status       UserStatus @default(INVITED)
  lastActiveAt DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([role])
  @@index([status])
  @@map("users")
}

/// Alumni association members
model Alumni {
  id                 String       @id @default(cuid())
  avatarUrl          String?
  registrationNumber String?      @unique
  faculty            String?
  department         String?
  graduationYear     Int?         @map("yearOfEntry")
  surname            String?
  firstName          String?
  otherNames         String?      @map("middleName")
  email              String?      @unique
  phone              String?
  countryOfOrigin    String?      @map("nationality")
  stateOfOrigin      String?
  town               String?      @map("localGovOfOrigin")
  countryOfResidence String?
  stateOfResidence   String?
  /// Legacy import fields (kept so existing CSV data is not dropped)
  sex                String?
  dateOfBirth        DateTime?    @db.Date
  homeCurrentAddress String?
  status             AlumniStatus @default(PENDING)
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  executives Executive[]

  @@index([faculty])
  @@index([department])
  @@index([graduationYear])
  @@index([status])
  @@map("alumni")
}

/// National / association executives shown on the public site
model Executive {
  id        String   @id @default(cuid())
  name      String
  role      String
  faculty   String?
  email     String?
  phone     String?
  tenure    String?
  imageUrl  String?
  published Boolean  @default(false)
  sortOrder Int      @default(0)
  alumniId  String?
  alumni    Alumni?  @relation(fields: [alumniId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([published])
  @@index([sortOrder])
  @@index([alumniId])
  @@map("executives")
}
